+/**
+ * Waits for the frame to carry exactly one rectangle for `label`, bounded by the
+ * SAME immutable target deadline the flow then spends: label discovery IS the
+ * selection step, so §E's one deadline covers it too. There is no second 30 s
+ * budget in front of the flow and no window is widened. This is the existing
+ * shared `pollObservation` at the same 250 ms `OBSERVATION_POLL_MS` step through
+ * the injected `schedule` — no phase timer, no second timer. A label that is not
+ * unique yet is "not yet", never a failure; only the deadline ends the wait.
+ */
+async function waitForLabel(stderrSource, label, deadline, clock, schedule) {
+  const polled = await pollObservation({
+    deadline,
+    clock,
+    schedule,
+    currentFact: () => frameFrom(stderrSource),
+    classify: () =>
+      tagForLabel(stderrSource, label) === null ? { ok: false, terminal: false } : { ok: true },
+  });
+  if (!polled.ok) return { ok: false, reason: polled.reason };
+  const tag = tagForLabel(stderrSource, label);
+  if (tag === null)
+    return { ok: false, reason: `no unique rectangle carries the label ${JSON.stringify(label)}` };
+  return { ok: true, tag };
 }
 
