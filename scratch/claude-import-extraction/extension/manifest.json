{
  "manifest_version": 3,
  "name": "Apunta conversation capture (research prototype)",
  "version": "0.1.0",
  "description": "Exports the signed-in account's own conversations to a local file Apunta can read. Nothing leaves the browser.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Apunta capture",
    "default_popup": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "http://127.0.0.1/*"],
      "js": ["capture-core.js", "inpage.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://claude.ai/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
