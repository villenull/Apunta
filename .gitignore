dist-mac/

# The Linux runtime resource folder (P3.1), built by
# scripts/v2/package-linux-resources.sh. A whole pinned Node tree, a bundled
# server and a native addon, all of it derived from the source next to it and
# none of it ever committed. Prettier reads .gitignore, which is what keeps the
# L1 `prettier --check .` off this generated output.
build/
