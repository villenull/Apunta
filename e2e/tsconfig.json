{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Specs contain browser-context code (page.evaluate), so they need DOM types.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["**/*.ts"]
}
