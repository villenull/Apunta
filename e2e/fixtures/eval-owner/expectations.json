{
  "_readme": [
    "Machine-readable expectations for the owner-format eval corpus \u2014 the sidecar",
    "specified by rubric.md \u00a77. One entry per transcript, filename as key.",
    "All patterns are JavaScript regular expression SOURCE strings, matched",
    "case-insensitively against the SERIALIZED note text (sectionsToText), not",
    "against the raw JSON, so escaping does not interfere. Per-section checks",
    "match against the individual section body.",
    "Every fixture is fabricated. See README.md."
  ],
  "_schema": {
    "format": "progress | intake \u2014 picks the instruction default via the same section fingerprint production uses",
    "sections": "the format's section names, in order",
    "modality": "how the source was produced; reporting only",
    "words": "source word count; reporting only",
    "difficulty": "one line, mirrors the coverage matrix in expectations.md",
    "markerFreeSource": "true when the F6 marker list finds zero matches in the source",
    "f6": "gating | flag \u2014 F6 gates the fixture only where markerFreeSource is true AND the fixture was written for this purpose",
    "blank": "sections that must be exactly '' \u2014 H4 ground truth",
    "statedAbsence": "sections where the clinician SAID the ground was not covered",
    "noConclusion": "sections the clinician drew no conclusion for \u2014 F6 ground truth",
    "mustNotContain": "F1 banned patterns; any match zeroes the fixture",
    "mustCapture": "C1/C2 facts; a fact matches if any alternative matches anywhere in the note",
    "requiresHedge": "H2 \u2014 topic and marker must co-occur in one sentence",
    "requiresMarker": "H5 \u2014 '[unclear in dictation]' must survive on this topic",
    "novelTermAllow": "F7 \u2014 clinical terms this fixture may legitimately introduce",
    "phraseBait": "V2 \u2014 profile phrases this source deliberately does NOT support"
  },
